{
  "manifest_version": 2,
  "name": "Any PiP",
  "description": "Picture in Picture for any video. Toolbar button or Option+Shift+P.",
  "version": "1.0",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "nativeMessaging",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle Picture in Picture"
    }
  },
  "browser_action": {
    "default_title": "Picture in Picture"
  }
}
